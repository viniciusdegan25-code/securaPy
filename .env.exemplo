# Copie este arquivo para ".env" e preencha os valores.

# MongoDB
MONGO_URI=mongodb+srv://securapy:SENHA_AQUI@siem-gs.bvdimvg.mongodb.net/
MONGO_BANCO=securapy

# MySQL
MYSQL_HOST=localhost
MYSQL_PORTA=3306
MYSQL_USUARIO=root
MYSQL_SENHA=SENHA_AQUI
MYSQL_BANCO=securapy

# API (Módulo D)
# Gere o segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Precisa ter pelo menos 32 caracteres, senão a API não inicia.
JWT_SECRET=
JWT_EXPIRA_MINUTOS=60
# Opcional: token do ipinfo.io para mais consultas de geolocalização
IPINFO_TOKEN=

# Dashboard web (Módulo E)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# 1 só quando o site estiver em HTTPS (o cookie de sessão passa a ser "Secure")
COOKIE_SECURE=0

# Assistente LLM (Módulo G). Sem chave, o assistente usa o fallback por regras.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Docker Compose (Módulo F): senha do root do MySQL do contêiner
MYSQL_ROOT_PASSWORD=
